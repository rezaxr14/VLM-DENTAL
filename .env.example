# ==============================================================================
# Dental-Agent Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NOTE: .env is git-ignored to prevent leaking your private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local model serving (Aim 1 Trace Generation — via vLLM)
# ------------------------------------------------------------------------------
# vLLM's OpenAI-compatible server runs inside the same Kaggle/Colab session as trace
# 1a. Trace Generator (Aim 1 vLLM inference server)
# For Colab T4 (15GB), use the pre-quantized AWQ checkpoint: QuantTrio/Qwen3.5-9B-AWQ
# For local PCs with >=24GB VRAM, you can use the full model: Qwen/Qwen3.5-9B
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1
GENERATOR_PROVIDER=local
GENERATOR_MODEL=QuantTrio/Qwen3.5-9B-AWQ

# 1b. Training Backbone (Stage 1 SFT & Stage 2 GRPO QLoRA fine-tuning)
# Must be the full unquantized checkpoint for backpropagation / adapter training.
MODEL_NAME=Qwen/Qwen3.5-9B

# ------------------------------------------------------------------------------
# 2. Verifier Candidates (External APIs)
# ------------------------------------------------------------------------------
# The ProviderPool will automatically round-robin across any of these that are set.
# Each provider enforces a strict 5-minute cooldown (1 request per 5 minutes) and
# a hard cap of 10 requests per day to aggressively limit usage.
# A provider is only activated if its API key AND verifier model are both set.

# NVIDIA NIM — https://build.nvidia.com, OpenAI-compatible at integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VERIFIER_MODEL=meta/muse-glimmer-30b

# Groq — https://console.groq.com, OpenAI-compatible at api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_VERIFIER_MODEL=qwen/qwen3.6-27b

# OpenRouter — https://openrouter.ai, OpenAI-compatible at openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VERIFIER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_REFERER=https://github.com/rezaxr14/VLM-DENTAL
OPENROUTER_TITLE=VLM-DENTAL

# Google Gemini API — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VERIFIER_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 3. Verifier Rate Limits
# ------------------------------------------------------------------------------
# The cooling time between requests on the SAME verifier provider (seconds). 300 = 5 minutes.
API_COOLDOWN_SECONDS=300
# The absolute maximum number of verifier requests per day per provider.
API_RPD_LIMIT=10

# ------------------------------------------------------------------------------
# 4. Generator Rate Limits (when using external API for generation)
# ------------------------------------------------------------------------------
# Only applies when GENERATOR_PROVIDER is NOT 'local'. When local, there are no
# rate limits — vLLM runs inside the same session.
GENERATOR_COOLDOWN_SECONDS=60
GENERATOR_RPD_LIMIT=50

# Per-provider generator models (leave blank to skip that provider for generation).
# These are only used when GENERATOR_PROVIDER is set to the corresponding provider name.
NVIDIA_GENERATOR_MODEL=
GROQ_GENERATOR_MODEL=
OPENROUTER_GENERATOR_MODEL=
GEMINI_GENERATOR_MODEL=

# ------------------------------------------------------------------------------
# 5. Hugging Face Hub (Model Checkpoints & Artifact Synchronization)
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
# Optional: Target artifact repository for cloud checkpoint sync (e.g. username/dentex-vlm-artifacts)
HF_ARTIFACT_REPO=

# ------------------------------------------------------------------------------
# 6. Weights & Biases (Experiment Tracking & Training Loss Logging - Optional)
# ------------------------------------------------------------------------------
WANDB_API_KEY=your_wandb_api_key_here

# ------------------------------------------------------------------------------
# 7. GitHub (Auto-push verified traces from Colab)
# ------------------------------------------------------------------------------
# Personal Access Token with repo write access. Used by the TraceGen notebook
# to commit and push verified traces after each session.
GITHUB_TOKEN=your_github_pat_here

# ------------------------------------------------------------------------------
# 8. Local Paths & Cache Directories (Optional Overrides)
# ------------------------------------------------------------------------------
# DENTAL_AGENT_PERSIST_DIR=
# DENTAL_AGENT_DATA_DIR=
