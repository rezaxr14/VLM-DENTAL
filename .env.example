# ==============================================================================
# Dental-Agent Environment Configuration
# ==============================================================================
# NOTE: .env is git-ignored to prevent leaking your private credentials.
# This file serves as the SINGLE SOURCE OF TRUTH for API keys and limits.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Model Serving (vLLM)
# ------------------------------------------------------------------------------
# For Colab T4 (15GB), use the pre-quantized AWQ checkpoint: QuantTrio/Qwen3.5-9B-AWQ
# For local PCs with >=24GB VRAM, you can use the full model: Qwen/Qwen3.5-9B
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1
GENERATOR_PROVIDER=local
GENERATOR_MODEL=QuantTrio/Qwen3.5-9B-AWQ
MODEL_NAME=Qwen/Qwen3.5-9B

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM Configuration (https://build.nvidia.com)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VERIFIER_MODEL=meta/muse-glimmer-30b
NVIDIA_GENERATOR_MODEL=meta/muse-glimmer-30b
NVIDIA_COOLDOWN_SECONDS=30
NVIDIA_RPD_LIMIT=500
NVIDIA_VERIFIER_RPM_LIMIT=20
NVIDIA_GENERATOR_RPM_LIMIT=20

# ------------------------------------------------------------------------------
# 3. Groq Configuration (https://console.groq.com)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_VERIFIER_MODEL=qwen/qwen3.6-27b
GROQ_GENERATOR_MODEL=qwen/qwen3.6-27b
GROQ_COOLDOWN_SECONDS=30
GROQ_RPD_LIMIT=500
GROQ_VERIFIER_RPM_LIMIT=15
GROQ_GENERATOR_RPM_LIMIT=15

# ------------------------------------------------------------------------------
# 4. OpenRouter Configuration (https://openrouter.ai)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VERIFIER_MODEL=openrouter/auto
OPENROUTER_GENERATOR_MODEL=openrouter/auto
OPENROUTER_COOLDOWN_SECONDS=30
OPENROUTER_RPD_LIMIT=25
OPENROUTER_VERIFIER_RPM_LIMIT=10
OPENROUTER_GENERATOR_RPM_LIMIT=10
OPENROUTER_REFERER=https://github.com/rezaxr14/VLM-DENTAL
OPENROUTER_TITLE=VLM-DENTAL

# ------------------------------------------------------------------------------
# 5. Gemini Configuration (https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VERIFIER_MODEL=gemini-3.7-flash
GEMINI_GENERATOR_MODEL=gemini-3.7-flash
GEMINI_COOLDOWN_SECONDS=300
GEMINI_RPD_LIMIT=20
GEMINI_VERIFIER_RPM_LIMIT=3
GEMINI_GENERATOR_RPM_LIMIT=3

# ------------------------------------------------------------------------------
# 6. Repositories and Tokens
# ------------------------------------------------------------------------------
# Hugging Face Hub (Model Checkpoints & Artifact Synchronization)
HF_TOKEN=your_huggingface_token_here
HF_ARTIFACT_REPO=Reza-Nadimi/vlm-dental-models
DENTEX_IMAGES_REPO=Reza-Nadimi/dentex-train-images

# GitHub (Auto-push verified traces from Colab)
GITHUB_TOKEN=your_github_pat_here

# Weights & Biases (Experiment Tracking & Training Loss Logging - Optional)
WANDB_API_KEY=your_wandb_api_key_here
