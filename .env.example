# ==============================================================================
# Dental-Agent Environment Configuration
# ==============================================================================
# NOTE: .env is git-ignored to prevent leaking your private credentials.
# This file serves as the SINGLE SOURCE OF TRUTH for API keys and limits.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Model Serving (vLLM)
# ------------------------------------------------------------------------------
# For Colab T4 (15GB), use the pre-quantized AWQ checkpoint: QuantTrio/Qwen3.5-9B-AWQ
# For local PCs with >=24GB VRAM, you can use the full model: Qwen/Qwen3.5-9B
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1
GENERATOR_PROVIDER=local
GENERATOR_MODEL=QuantTrio/Qwen3.5-9B-AWQ
MODEL_NAME=Qwen/Qwen3.5-9B
LOCAL_MAX_TOKENS=8192
LOCAL_IMAGE_MAX_DIM=0

# Grounding tool (locate_tooth) -- YOLOv8, 5-fold CV. Path fix: this used to default to
# a stale directory name (grounding_tool_m) that never matched where training actually
# saves the final model (grounding_tool_cv_best) -- every locate_tooth call was failing
# with "model not found" until this was corrected.
GROUNDING_MODEL_PATH=data/models/grounding_tool_cv_best/weights/best.pt

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM Configuration (https://build.nvidia.com)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VERIFIER_MODEL=meta/muse-glimmer-30b
NVIDIA_GENERATOR_MODEL=meta/muse-glimmer-30b
NVIDIA_COOLDOWN_SECONDS=5
NVIDIA_RPD_LIMIT=2000
NVIDIA_VERIFIER_RPM_LIMIT=20
NVIDIA_GENERATOR_RPM_LIMIT=20
NVIDIA_MAX_TOKENS=16384
NVIDIA_IMAGE_MAX_DIM=0

# ------------------------------------------------------------------------------
# 3. Groq Configuration (https://console.groq.com)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_VERIFIER_MODEL=qwen/qwen3.6-27b
GROQ_GENERATOR_MODEL=qwen/qwen3.6-27b
GROQ_COOLDOWN_SECONDS=5
GROQ_RPD_LIMIT=1000
GROQ_VERIFIER_RPM_LIMIT=15
GROQ_GENERATOR_RPM_LIMIT=15
GROQ_MAX_TOKENS=2048
GROQ_IMAGE_MAX_DIM=1280

# ------------------------------------------------------------------------------
# 4. OpenRouter Configuration (https://openrouter.ai)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VERIFIER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_GENERATOR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_COOLDOWN_SECONDS=5
OPENROUTER_RPD_LIMIT=25
OPENROUTER_VERIFIER_RPM_LIMIT=10
OPENROUTER_GENERATOR_RPM_LIMIT=10
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_IMAGE_MAX_DIM=1600
OPENROUTER_REFERER=https://github.com/rezaxr14/VLM-DENTAL
OPENROUTER_TITLE=VLM-DENTAL

# ------------------------------------------------------------------------------
# 5. Gemini Configuration (https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VERIFIER_MODEL=gemini-3.5-flash-lite
GEMINI_GENERATOR_MODEL=gemini-3.5-flash-lite
GEMINI_COOLDOWN_SECONDS=30
GEMINI_RPD_LIMIT=400 # 500 for lite , 20 for flash
GEMINI_VERIFIER_RPM_LIMIT=4
GEMINI_GENERATOR_RPM_LIMIT=4
GEMINI_MAX_TOKENS=16384
GEMINI_IMAGE_MAX_DIM=0
# Hard ceiling -- GENERATOR/VERIFIER_RPM_LIMIT above are clamped to this regardless of
# what they're set to (min(requested, hard_cap)), so setting either to e.g. 10 by
# mistake still only ever dispatches at 5. This is the real documented Gemini free-tier
# limit, not a value to tune casually.
GEMINI_RPM_HARD_CAP=10 #15 max for lite , 5 for flash

# ------------------------------------------------------------------------------
# 6. Repositories and Tokens
# ------------------------------------------------------------------------------
# Hugging Face Hub (Model Checkpoints & Artifact Synchronization)
HF_TOKEN=your_huggingface_token_here
HF_ARTIFACT_REPO=Reza-Nadimi/vlm-dental-models
DENTEX_IMAGES_REPO=Reza-Nadimi/dentex-train-images

# Tufts Dental Database (access-gated -- request at https://tdd.ece.tufts.edu/,
# download and extract it yourself; this is NOT auto-fetched the way DENTEX is).
# TUFTS_LOCAL_DIR: path to your extracted copy, for the one-time HF upload step.
# TUFTS_IMAGES_REPO: same per-image-download mechanism as DENTEX, once uploaded.
TUFTS_LOCAL_DIR=/path/to/extracted/Tufts-Dental-Database
TUFTS_IMAGES_REPO=Reza-Nadimi/tufts-train-images

# GitHub (Auto-push verified traces from Colab)
GITHUB_TOKEN=your_github_pat_here

# Weights & Biases (Experiment Tracking & Training Loss Logging - Optional)
WANDB_API_KEY=your_wandb_api_key_here
