# ==============================================================================
# Dental-Agent Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NOTE: .env is git-ignored to prevent leaking your private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local model serving (Aim 1 Trace Generation — Qwen3-VL-8B-Thinking via vLLM)
# ------------------------------------------------------------------------------
# vLLM's OpenAI-compatible server runs inside the same Kaggle/Colab session as trace
# generation, so this is normally just localhost — no API key needed.
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1
GENERATOR_PROVIDER=local
GENERATOR_MODEL=Qwen/Qwen3-VL-8B-Thinking

# ------------------------------------------------------------------------------
# 2. Verifier candidates (cross-family check on generated traces)
# ------------------------------------------------------------------------------
# The verifier just needs to be a DIFFERENT model family than the generator above —
# no specific model is required. Set VERIFIER_PROVIDER + VERIFIER_MODEL directly to
# pin one explicitly; otherwise the first of these below with both a key and a
# *_VERIFIER_MODEL set is picked automatically (see trace_generation.py::_resolve_verifier).
VERIFIER_PROVIDER=
VERIFIER_MODEL=

# NVIDIA NIM — https://build.nvidia.com, OpenAI-compatible at integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VERIFIER_MODEL=

# Groq — https://console.groq.com, OpenAI-compatible at api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GROQ_VERIFIER_MODEL=

# OpenRouter — https://openrouter.ai, OpenAI-compatible at openrouter.ai/api/v1
# Model IDs are "provider/model" slugs, e.g. anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VERIFIER_MODEL=
OPENROUTER_REFERER=https://github.com/rezaxr14/VLM-DENTAL
OPENROUTER_TITLE=VLM-DENTAL

# ------------------------------------------------------------------------------
# 3. Google Gemini API (legacy — no longer the trace-gen generator; kept as an
#    optional verifier candidate or manual fallback only)
# ------------------------------------------------------------------------------
# For single key usage:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VERIFIER_MODEL=

# For multiple keys (comma-separated round-robin pool to avoid rate limits):
# GEMINI_API_KEYS=key_1,key_2,key_3,key_4

# Models and Automatic Quota Fallback (e.g. 20 RPD on 3.6 + 20 RPD on 3.5 = 40 RPD/key):
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Gemini Rate Limits (Free tier defaults: 5 RPM, 20 RPD per model per key):
GEMINI_RPM_LIMIT=5
GEMINI_RPD_LIMIT=20

# ------------------------------------------------------------------------------
# 4. OpenAI API (GPT-4o Baseline & LLM-as-Judge Grounding Evaluator)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. Anthropic Claude API (baselines & optional verifier candidate)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_VERIFIER_MODEL=

# ------------------------------------------------------------------------------
# 6. Hugging Face Hub (Model Checkpoints & Artifact Synchronization)
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
# Optional: Target artifact repository for cloud checkpoint sync (e.g. username/dentex-vlm-artifacts)
HF_ARTIFACT_REPO=

# ------------------------------------------------------------------------------
# 7. Weights & Biases (Experiment Tracking & Training Loss Logging - Optional)
# ------------------------------------------------------------------------------
WANDB_API_KEY=your_wandb_api_key_here

# ------------------------------------------------------------------------------
# 8. Local Paths & Cache Directories (Optional Overrides)
# ------------------------------------------------------------------------------
# DENTAL_AGENT_PERSIST_DIR=
# DENTAL_AGENT_DATA_DIR=
