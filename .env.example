# ==============================================================================
# Dental-Agent Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# NOTE: .env is git-ignored to prevent leaking your private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Teacher Trace Generation & Distillation)
# ------------------------------------------------------------------------------
# For single key usage:
GEMINI_API_KEY=your_gemini_api_key_here

# For multiple keys (comma-separated round-robin pool to avoid rate limits):
# GEMINI_API_KEYS=key_1,key_2,key_3,key_4

# Models and Automatic Quota Fallback (e.g. 20 RPD on 3.6 + 20 RPD on 3.5 = 40 RPD/key):
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Gemini Rate Limits (Free tier defaults: 5 RPM, 20 RPD per model per key):
GEMINI_RPM_LIMIT=5
GEMINI_RPD_LIMIT=20

# ------------------------------------------------------------------------------
# 2. OpenAI API (GPT-4o Baseline & LLM-as-Judge Grounding Evaluator)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Anthropic Claude API (Claude 3.5 Sonnet Baselines & Cross-Verification)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. Hugging Face Hub (Model Checkpoints & Artifact Synchronization)
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
# Optional: Target artifact repository for cloud checkpoint sync (e.g. username/dentex-vlm-artifacts)
HF_ARTIFACT_REPO=

# ------------------------------------------------------------------------------
# 5. Weights & Biases (Experiment Tracking & Training Loss Logging - Optional)
# ------------------------------------------------------------------------------
WANDB_API_KEY=your_wandb_api_key_here

# ------------------------------------------------------------------------------
# 6. Local Paths & Cache Directories (Optional Overrides)
# ------------------------------------------------------------------------------
# DENTAL_AGENT_PERSIST_DIR=
# DENTAL_AGENT_DATA_DIR=
