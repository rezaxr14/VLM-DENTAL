\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Corrective-nudge behavior split by reference type, regenerated from the released corpus. \emph  {GT-anchored}: the locate call was ground-truth-grounded (annotated tooth; pathology cohorts) and the reference box is the expert box. \emph  {Detector-anchored}: exploratory calls (dominated by healthy-scan full-arch surveys), where the reference is the detector's own box. During rapid surveys the teacher corrects far less often per box --- a real behavioral difference we report rather than average away.}}{29}{table.caption.47}\protected@file@percent }
\newlabel{tab:mechanismsplit}{{7}{29}{Corrective-nudge behavior split by reference type, regenerated from the released corpus. \emph {GT-anchored}: the locate call was ground-truth-grounded (annotated tooth; pathology cohorts) and the reference box is the expert box. \emph {Detector-anchored}: exploratory calls (dominated by healthy-scan full-arch surveys), where the reference is the detector's own box. During rapid surveys the teacher corrects far less often per box --- a real behavioral difference we report rather than average away}{table.caption.47}{}}
