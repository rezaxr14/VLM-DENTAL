\@writefile{toc}{\contentsline {section}{\numberline {B}Mechanism analysis: full split by reference type}{22}{appendix.B}\protected@file@percent }
\newlabel{app:mechanism}{{B}{22}{Mechanism analysis: full split by reference type}{appendix.B}{}}
\newlabel{app:mechanism@cref}{{[section][2][]B}{[1][21][]22}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Corrective-nudge behavior split by reference type, regenerated from the released corpus. \emph  {GT-anchored}: the locate call was ground-truth-grounded (annotated tooth; pathology cohorts) and the reference box is the expert box. \emph  {Detector-anchored}: exploratory calls (dominated by healthy-scan full-arch surveys), where the reference is the detector's own box. During rapid surveys the teacher corrects far less often per box --- a real behavioral difference we report rather than average away.}}{22}{table.caption.41}\protected@file@percent }
\newlabel{tab:mechanismsplit}{{7}{22}{Corrective-nudge behavior split by reference type, regenerated from the released corpus. \emph {GT-anchored}: the locate call was ground-truth-grounded (annotated tooth; pathology cohorts) and the reference box is the expert box. \emph {Detector-anchored}: exploratory calls (dominated by healthy-scan full-arch surveys), where the reference is the detector's own box. During rapid surveys the teacher corrects far less often per box --- a real behavioral difference we report rather than average away}{table.caption.41}{}}
\newlabel{tab:mechanismsplit@cref}{{[table][7][]7}{[1][21][]22}{}{}{}}
