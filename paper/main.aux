\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The tiered perturbation mechanism and the correction loop it trains. The perturbation applies to the box shown to the policy only; offsets reuse \texttt  {nudge\_crop}'s own math; and no verbal cue marks an error, so the offset magnitude alone must carry the signal.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:mechanism}{{6}{10}{The tiered perturbation mechanism and the correction loop it trains. The perturbation applies to the box shown to the policy only; offsets reuse \texttt {nudge\_crop}'s own math; and no verbal cue marks an error, so the offset magnitude alone must carry the signal}{figure.caption.13}{}}
\newlabel{fig:mechanism@cref}{{[figure][6][]6}{[1][9][]10}{}{}{}}
