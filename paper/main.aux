\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The \texttt  {locate\_tooth} backend: YOLOv8m trained with 5-fold cross-validation on the combined DENTEX+Tufts pool (2{,}339 images, 46{,}808 tooth boxes). Left: in-fold target mAP50 per fold for the DENTEX-only and multi-dataset models (means 0.9508 / 0.9376). Right: pool composition, the held-out official DENTEX validation (best target mAP50 0.9593 at precision 0.9864 --- the deployed checkpoint), and the trace-generation guarantee: when a requested tooth exists in the ground truth, \texttt  {locate\_tooth} returns its exact box, and only the \emph  {displayed} copy is perturbed. Exact per-fold numbers in \cref  {app:grounding}.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:groundingcv}{{5}{9}{The \texttt {locate\_tooth} backend: YOLOv8m trained with 5-fold cross-validation on the combined DENTEX+Tufts pool (2{,}339 images, 46{,}808 tooth boxes). Left: in-fold target mAP50 per fold for the DENTEX-only and multi-dataset models (means 0.9508 / 0.9376). Right: pool composition, the held-out official DENTEX validation (best target mAP50 0.9593 at precision 0.9864 --- the deployed checkpoint), and the trace-generation guarantee: when a requested tooth exists in the ground truth, \texttt {locate\_tooth} returns its exact box, and only the \emph {displayed} copy is perturbed. Exact per-fold numbers in \cref {app:grounding}}{figure.caption.10}{}}
\newlabel{fig:groundingcv@cref}{{[figure][5][]5}{[1][6][]9}{}{}{}}
