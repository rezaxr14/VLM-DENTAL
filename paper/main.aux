\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The VLM-DENTAL{} pipeline. Traces are synthesized by a frontier teacher operating a real tool suite in a LangGraph loop (with the tiered perturbation hook of \cref  {sec:perturbation}), verified cross-family against expert labels, and used for SFT followed by GRPO with a ground-truth-anchored composite reward. Tool calls execute for real against the source image at every stage; the radiograph and crop pixels are real assets from the corpus (the image whose trace anatomy is dissected in \cref  {fig:traces}).}}{5}{figure.caption.5}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{5}{The \sys {} pipeline. Traces are synthesized by a frontier teacher operating a real tool suite in a LangGraph loop (with the tiered perturbation hook of \cref {sec:perturbation}), verified cross-family against expert labels, and used for SFT followed by GRPO with a ground-truth-anchored composite reward. Tool calls execute for real against the source image at every stage; the radiograph and crop pixels are real assets from the corpus (the image whose trace anatomy is dissected in \cref {fig:traces})}{figure.caption.5}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][]1}{[1][4][]5}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}A tool suite with continuous parameters}{5}{subsection.3.3}\protected@file@percent }
