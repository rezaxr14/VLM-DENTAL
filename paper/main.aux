\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The VLM-DENTAL{} architecture. One agent loop, one shared tool dispatcher, and one canonical vision geometry are shared by trace generation, RL rollouts, and evaluation; the trace synthesis stack produces the verified corpus consumed by SFT and GRPO; evaluation probes select on a dev split only, with the test split run once at the end. Numbered badges trace the corpus-to-policy life cycle (legend in the figure); radiograph and crop pixels are real assets from the corpus.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:architecture}{{3}{7}{The \sys {} architecture. One agent loop, one shared tool dispatcher, and one canonical vision geometry are shared by trace generation, RL rollouts, and evaluation; the trace synthesis stack produces the verified corpus consumed by SFT and GRPO; evaluation probes select on a dev split only, with the test split run once at the end. Numbered badges trace the corpus-to-policy life cycle (legend in the figure); radiograph and crop pixels are real assets from the corpus}{figure.caption.7}{}}
\newlabel{fig:architecture@cref}{{[figure][3][]3}{[1][4][]7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The VLM-DENTAL{} tool suite. Continuous or overridable parameters are shown in \emph  {italics}; data-only tools return coordinates rather than images.}}{7}{table.caption.9}\protected@file@percent }
\newlabel{tab:tools}{{1}{7}{The \sys {} tool suite. Continuous or overridable parameters are shown in \emph {italics}; data-only tools return coordinates rather than images}{table.caption.9}{}}
\newlabel{tab:tools@cref}{{[table][1][]1}{[1][5][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Image-input geometry: two execution targets, one invariant. \textbf  {TPU:} the policy sees aspect-preserving canonical views in three fixed families (renders produced by the geometry module itself, and the \texttt  {contralateral\_compare} tool, from a DENTEX image), padded to a static 19-slot budget of 7{,}488 vision tokens so XLA compiles one graph; the padded tail carries $\text  {labels}=-100$ and $\text  {attention\_mask}=0$, so padding changes no gradient. \textbf  {GPU:} runs so far feed original images with dynamic shapes. The choice between the targets is explicitly open pending the first GPU run; in both, tools always execute on the native image and evaluation runs at original size.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:inputgeom}{{4}{8}{Image-input geometry: two execution targets, one invariant. \textbf {TPU:} the policy sees aspect-preserving canonical views in three fixed families (renders produced by the geometry module itself, and the \texttt {contralateral\_compare} tool, from a DENTEX image), padded to a static 19-slot budget of 7{,}488 vision tokens so XLA compiles one graph; the padded tail carries $\text {labels}=-100$ and $\text {attention\_mask}=0$, so padding changes no gradient. \textbf {GPU:} runs so far feed original images with dynamic shapes. The choice between the targets is explicitly open pending the first GPU run; in both, tools always execute on the native image and evaluation runs at original size}{figure.caption.8}{}}
\newlabel{fig:inputgeom@cref}{{[figure][4][]4}{[1][5][]8}{}{}{}}
