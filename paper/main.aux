\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Corpus composition (measured from the released trace files). Five cohorts --- three findings-bearing, two healthy negative controls --- exist in two exact arms (with-tools and no-tools) with per-cohort 1:1 parity; the with-tools corpus carries 5{,}144 finding-level annotations (4{,}513 unique: the 202-image Tufts overlap cohort is contained in the 280-image Tufts all-diseases cohort, so its findings are counted in both). Class mix of the unique findings below; the teacher surveys every finding on an image, and healthy scans carry empty finding sets.}}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:corpus}{{12}{17}{Corpus composition (measured from the released trace files). Five cohorts --- three findings-bearing, two healthy negative controls --- exist in two exact arms (with-tools and no-tools) with per-cohort 1:1 parity; the with-tools corpus carries 5{,}144 finding-level annotations (4{,}513 unique: the 202-image Tufts overlap cohort is contained in the 280-image Tufts all-diseases cohort, so its findings are counted in both). Class mix of the unique findings below; the teacher surveys every finding on an image, and healthy scans carry empty finding sets}{figure.caption.19}{}}
\newlabel{fig:corpus@cref}{{[figure][12][]12}{[1][15][]17}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The verified corpus, regenerated from the released trace files. With-tools and no-tools cohorts are in exact 1:1 parity (checkmarks). Turns and tool calls are for the with-tools side; findings are counted per cohort (the Tufts overlap cohort is a subset of the Tufts all-diseases cohort, so its findings are counted in both).}}{17}{table.caption.20}\protected@file@percent }
\newlabel{tab:corpus}{{2}{17}{The verified corpus, regenerated from the released trace files. With-tools and no-tools cohorts are in exact 1:1 parity (checkmarks). Turns and tool calls are for the with-tools side; findings are counted per cohort (the Tufts overlap cohort is a subset of the Tufts all-diseases cohort, so its findings are counted in both)}{table.caption.20}{}}
\newlabel{tab:corpus@cref}{{[table][2][]2}{[1][16][]17}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Recorded tool-call attempts over the verified with-tools corpus (44{,}350 across 1{,}847 traces, of which 48 were invalid --- e.g.\ a hallucinated \texttt  {localize\_tooth} --- and returned a standard error observation to the agent). \texttt  {zoom\_crop} and \texttt  {locate\_tooth} dominate; \texttt  {nudge\_crop} appears 2{,}292 times as genuine mid-episode correction.}}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:toolusage}{{13}{18}{Recorded tool-call attempts over the verified with-tools corpus (44{,}350 across 1{,}847 traces, of which 48 were invalid --- e.g.\ a hallucinated \texttt {localize\_tooth} --- and returned a standard error observation to the agent). \texttt {zoom\_crop} and \texttt {locate\_tooth} dominate; \texttt {nudge\_crop} appears 2{,}292 times as genuine mid-episode correction}{figure.caption.21}{}}
\newlabel{fig:toolusage@cref}{{[figure][13][]13}{[1][16][]18}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Evidence trail for one DENTEX image (image 624, a carious FDI tooth 34): the real radiograph with the returned grounding box (blue), the three corrective \texttt  {nudge\_crop} boxes (orange, light to dark, magnified in the 4.5$\times $ inset; the arrow marks the upward walk from the returned box to the corrected one), and the expert box (green dashed). All coordinates are the values actually returned by the tools, and the narrow right-hand panel shows the crop the teacher finally saw.}}{18}{figure.caption.22}\protected@file@percent }
\newlabel{fig:evidence}{{14}{18}{Evidence trail for one DENTEX image (image 624, a carious FDI tooth 34): the real radiograph with the returned grounding box (blue), the three corrective \texttt {nudge\_crop} boxes (orange, light to dark, magnified in the 4.5$\times $ inset; the arrow marks the upward walk from the returned box to the corrected one), and the expert box (green dashed). All coordinates are the values actually returned by the tools, and the narrow right-hand panel shows the crop the teacher finally saw}{figure.caption.22}{}}
