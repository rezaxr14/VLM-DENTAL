\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The VLM-DENTAL{} pipeline. Traces are synthesized by a frontier teacher operating a real tool suite in a LangGraph loop (with the tiered perturbation hook of \cref  {sec:perturbation}), verified cross-family against expert labels, and used for SFT followed by GRPO with a ground-truth-anchored composite reward. Tool calls execute for real against the source image at every stage; the radiograph and crop pixels are real assets from the corpus (the image whose trace anatomy is dissected in \cref  {fig:traces}).}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{6}{The \sys {} pipeline. Traces are synthesized by a frontier teacher operating a real tool suite in a LangGraph loop (with the tiered perturbation hook of \cref {sec:perturbation}), verified cross-family against expert labels, and used for SFT followed by GRPO with a ground-truth-anchored composite reward. Tool calls execute for real against the source image at every stage; the radiograph and crop pixels are real assets from the corpus (the image whose trace anatomy is dissected in \cref {fig:traces})}{figure.caption.6}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][5][]6}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}A tool suite with continuous parameters}{6}{subsection.3.3}\protected@file@percent }
\newlabel{sec:tools}{{3.3}{6}{A tool suite with continuous parameters}{subsection.3.3}{}}
\newlabel{sec:tools@cref}{{[subsection][3][3]3.3}{[1][5][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The data layer. Two sources are in use --- DENTEX (the only panoramic dataset pairing tooth position with all four reward-relevant pathology classes) and the Tufts Dental Database (per-tooth boxes plus an expert pathology layer whose periapical class maps onto the DENTEX taxonomy). Eight further public panoramic datasets are catalogued as candidates and deliberately \emph  {not} used: each would be promoted only after its annotation semantics are verified end-to-end, and two loaders currently stop at exactly one open question rather than guess. The diagnosis-label vs grounding-only flag drives purpose: grounding candidates generalize \texttt  {locate\_tooth}, diagnosis candidates would feed trace generation. The catalog is transcribed from a systematic review of 16 public dental imaging datasets \citep  {uribe2024systematic} plus a targeted follow-up search; the radiographs are real examples of the two sources, with their expert boxes.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:datasets}{{3}{7}{The data layer. Two sources are in use --- DENTEX (the only panoramic dataset pairing tooth position with all four reward-relevant pathology classes) and the Tufts Dental Database (per-tooth boxes plus an expert pathology layer whose periapical class maps onto the DENTEX taxonomy). Eight further public panoramic datasets are catalogued as candidates and deliberately \emph {not} used: each would be promoted only after its annotation semantics are verified end-to-end, and two loaders currently stop at exactly one open question rather than guess. The diagnosis-label vs grounding-only flag drives purpose: grounding candidates generalize \texttt {locate\_tooth}, diagnosis candidates would feed trace generation. The catalog is transcribed from a systematic review of 16 public dental imaging datasets \citep {uribe2024systematic} plus a targeted follow-up search; the radiographs are real examples of the two sources, with their expert boxes}{figure.caption.7}{}}
\newlabel{fig:datasets@cref}{{[figure][3][]3}{[1][5][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The VLM-DENTAL{} agent loop. One agent loop, one shared tool dispatcher, and one canonical vision geometry are shared by trace generation, RL rollouts, and evaluation. The policy (Qwen3.5-9B with pluggable SFT/GRPO LoRA adapters) calls the registered tools, which always execute on the native source image; the final findings JSON is scored by an evaluation layer whose probes select on a dev split only, with the test split run once at the end. Badges 4--6 continue the numbered path of \cref  {fig:training}; radiograph and crop pixels are real assets from the corpus.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:architecture}{{4}{8}{The \sys {} agent loop. One agent loop, one shared tool dispatcher, and one canonical vision geometry are shared by trace generation, RL rollouts, and evaluation. The policy (Qwen3.5-9B with pluggable SFT/GRPO LoRA adapters) calls the registered tools, which always execute on the native source image; the final findings JSON is scored by an evaluation layer whose probes select on a dev split only, with the test split run once at the end. Badges 4--6 continue the numbered path of \cref {fig:training}; radiograph and crop pixels are real assets from the corpus}{figure.caption.8}{}}
\newlabel{fig:architecture@cref}{{[figure][4][]4}{[1][5][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The VLM-DENTAL{} offline stack. The data layer (DENTEX and Tufts, ground truth with one to seven findings per image, and the YOLOv8m grounding model) feeds the trace-synthesis stack (stage details in \cref  {fig:tracegen,fig:traceverif}); the verified corpus is consumed by SFT and then GRPO, which produce the LoRA adapters loaded by the policy of \cref  {fig:architecture}. Numbered badges trace the corpus-to-policy life cycle (legend under the figure); the dashed boxes are the agent-loop components shown in \cref  {fig:architecture}.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:training}{{5}{9}{The \sys {} offline stack. The data layer (DENTEX and Tufts, ground truth with one to seven findings per image, and the YOLOv8m grounding model) feeds the trace-synthesis stack (stage details in \cref {fig:tracegen,fig:traceverif}); the verified corpus is consumed by SFT and then GRPO, which produce the LoRA adapters loaded by the policy of \cref {fig:architecture}. Numbered badges trace the corpus-to-policy life cycle (legend under the figure); the dashed boxes are the agent-loop components shown in \cref {fig:architecture}}{figure.caption.9}{}}
\newlabel{fig:training@cref}{{[figure][5][]5}{[1][5][]9}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Image-input geometry: two execution targets, one invariant. \textbf  {TPU:} the policy sees aspect-preserving canonical views in three fixed families (renders produced by the geometry module itself, and the \texttt  {contralateral\_compare} tool, from DENTEX image 624), padded to a static 19-slot budget of 7{,}488 vision tokens so XLA compiles one graph; the padded tail carries $\text  {labels}=-100$ and $\text  {attention\_mask}=0$, so padding changes no gradient. \textbf  {GPU:} runs so far feed original images with dynamic shapes. The choice between the targets is explicitly open pending the first GPU run; in both, tools always execute on the native image and evaluation runs at original size.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:inputgeom}{{6}{10}{Image-input geometry: two execution targets, one invariant. \textbf {TPU:} the policy sees aspect-preserving canonical views in three fixed families (renders produced by the geometry module itself, and the \texttt {contralateral\_compare} tool, from DENTEX image 624), padded to a static 19-slot budget of 7{,}488 vision tokens so XLA compiles one graph; the padded tail carries $\text {labels}=-100$ and $\text {attention\_mask}=0$, so padding changes no gradient. \textbf {GPU:} runs so far feed original images with dynamic shapes. The choice between the targets is explicitly open pending the first GPU run; in both, tools always execute on the native image and evaluation runs at original size}{figure.caption.10}{}}
\newlabel{fig:inputgeom@cref}{{[figure][6][]6}{[1][5][]10}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The VLM-DENTAL{} tool suite. Continuous or overridable parameters are shown in \emph  {italics}; data-only tools return coordinates rather than images.}}{11}{table.caption.11}\protected@file@percent }
