\@writefile{toc}{\contentsline {section}{\numberline {B}Mechanism analysis: full split by reference type}{27}{appendix.B}\protected@file@percent }
\newlabel{app:mechanism}{{B}{27}{Mechanism analysis: full split by reference type}{appendix.B}{}}
\newlabel{app:mechanism@cref}{{[appendix][2][2147483647]B}{[1][27][]27}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Corrective-nudge behavior split by reference type. \emph  {GT-anchored}: the locate call was ground-truth-grounded (annotated tooth; pathology cohorts) and the reference box is the expert box. \emph  {Detector-anchored}: exploratory calls (dominated by healthy-scan full-arch surveys), where the reference is the detector's own box. During rapid surveys the teacher corrects far less often per box, a difference in behavior that pooled rates would hide. IoU before is the mean over all locates with a recovered shown box; IoU after is the mean over the corrected locates only. \cref  {tab:nudgetier} pairs both over the corrected locates, so its before values differ.}}{28}{table.caption.48}\protected@file@percent }
\newlabel{tab:mechanismsplit}{{10}{28}{Corrective-nudge behavior split by reference type. \emph {GT-anchored}: the locate call was ground-truth-grounded (annotated tooth; pathology cohorts) and the reference box is the expert box. \emph {Detector-anchored}: exploratory calls (dominated by healthy-scan full-arch surveys), where the reference is the detector's own box. During rapid surveys the teacher corrects far less often per box, a difference in behavior that pooled rates would hide. IoU before is the mean over all locates with a recovered shown box; IoU after is the mean over the corrected locates only. \cref {tab:nudgetier} pairs both over the corrected locates, so its before values differ}{table.caption.48}{}}
\newlabel{tab:mechanismsplit@cref}{{[table][10][2147483647]10}{[1][27][]28}}
