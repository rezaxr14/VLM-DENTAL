\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Exact tiered-perturbation configuration used for trace generation. Offsets are drawn uniformly per axis with a random sign and applied with \texttt  {nudge\_crop}'s own shift-and-clamp math, so every shown box is one the correction tool could produce or fix. The unperturbed box is logged internally per call (\texttt  {true\_bbox}, \texttt  {perturb\_tier}) and never shown to the model.}}{21}{table.caption.40}\protected@file@percent }
\newlabel{tab:perturbconfig}{{6}{21}{Exact tiered-perturbation configuration used for trace generation. Offsets are drawn uniformly per axis with a random sign and applied with \texttt {nudge\_crop}'s own shift-and-clamp math, so every shown box is one the correction tool could produce or fix. The unperturbed box is logged internally per call (\texttt {true\_bbox}, \texttt {perturb\_tier}) and never shown to the model}{table.caption.40}{}}
